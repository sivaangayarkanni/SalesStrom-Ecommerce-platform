    end
    subgraph AZ2[Availability Zone 2]
      K2[Kubernetes nodes - all services]
      PGS[(Postgres Sync Standby)]
      R2[(Redis replica)]
      KF2[[Kafka broker]]
    end
    subgraph AZ3[Availability Zone 3]
      K3[Kubernetes nodes - all services]
