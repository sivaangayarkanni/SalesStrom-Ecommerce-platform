<mxfile host="app.diagrams.net" agent="SALESTORM" version="24.7.17"><diagram id="Concurrency Flow" name="Concurrency Flow"><mxGraphModel dx="1400" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1300" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value='&lt;b&gt;Concurrency — How one Buy click is decided&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:13px" color="#666666"&gt;Each check can only say NO; the final YES is a Postgres commit&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=0;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1360" height="60" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Buy Now click&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;shadow=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="90" width="200" height="50" as="geometry"/></mxCell><mxCell id="c3" value="L1 CDN:&lt;br&gt;&lt;b&gt;SOLD_OUT flag?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;shadow=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="565" y="170" width="190" height="100" as="geometry"/></mxCell><mxCell id="c4" value="L2 / gateway:&lt;br&gt;&lt;b&gt;Idempotency-Key seen?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;shadow=1;fontSize=12;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="565" y="310" width="190" height="100" as="geometry"/></mxCell><mxCell id="c5" value="L3 Redis (16 salted&lt;br&gt;sub-pools): &lt;b&gt;token?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;shadow=1;fontSize=12;fillColor=#1ba1e2;strokeColor=#006eaf;" vertex="1" parent="1"><mxGeometry x="565" y="450" width="190" height="100" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;L4 Postgres TX&lt;/b&gt;&lt;br&gt;SELECT unit FOR UPDATE SKIP LOCKED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;shadow=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="535" y="600" width="250" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;UNIQUE(sale, customer)&lt;/b&gt;&lt;br&gt;ok?" style="rhombus;whiteSpace=wrap;html=1;shadow=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="565" y="710" width="190" height="100" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;✔ RESERVED&lt;/b&gt;&lt;br&gt;201 · pay within 5 min" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;shadow=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="860" width="200" height="65" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;409 SOLD OUT&lt;/b&gt;&lt;br&gt;served from edge (~10 ms)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;shadow=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="950" y="185" width="230" height="65" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Replay stored response&lt;/b&gt;&lt;br&gt;no new work" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;shadow=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="950" y="325" width="230" height="65" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;409 SOLD OUT&lt;/b&gt;&lt;br&gt;INCR back · set SOLD_OUT flag" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;shadow=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="950" y="465" width="230" height="65" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;409 Already purchased&lt;/b&gt;&lt;br&gt;ROLLBACK · INCR token" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;shadow=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="950" y="725" width="230" height="65" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;Write skew, blocked&lt;/b&gt;&lt;br&gt;Naive: two TXs both read &lt;i&gt;stock = 1&lt;/i&gt; and both decrement → unit #101.&lt;br&gt;Here each TX locks a &lt;b&gt;different unit row&lt;/b&gt; (SKIP LOCKED); a partial UNIQUE allows one live reservation per unit, and CHECK(available ≥ 0) catches any bug. Works at READ COMMITTED; no SERIALIZABLE retries." style="shape=note;whiteSpace=wrap;html=1;size=14;shadow=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="90" y="600" width="400" height="135" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Before L3:&lt;/b&gt; LoadShedder rejects with 503 + Retry-After when in-flight work would miss its 300 ms deadline." style="shape=note;whiteSpace=wrap;html=1;size=14;shadow=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="90" y="330" width="360" height="80" as="geometry"/></mxCell><mxCell id="e21" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="Simulated outcome (10,200 requests)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#666666;opacity=55;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="120" y="960" width="1160" height="250" as="geometry"/></mxCell><mxCell id="c26" value='&lt;font style="font-size:24px"&gt;&lt;b&gt;9,921&lt;/b&gt;&lt;/font&gt;&lt;br&gt;stopped at L1' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;shadow=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="150" y="1020" width="165" height="90" as="geometry"/></mxCell><mxCell id="c27" value='&lt;font style="font-size:24px"&gt;&lt;b&gt;163&lt;/b&gt;&lt;/font&gt;&lt;br&gt;stopped at L2' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;shadow=1;fontSize=13;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="335" y="1020" width="165" height="90" as="geometry"/></mxCell><mxCell id="c28" value='&lt;font style="font-size:24px"&gt;&lt;b&gt;7&lt;/b&gt;&lt;/font&gt;&lt;br&gt;stopped at L3' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;shadow=1;fontSize=13;fillColor=#1ba1e2;strokeColor=#006eaf;" vertex="1" parent="1"><mxGeometry x="520" y="1020" width="165" height="90" as="geometry"/></mxCell><mxCell id="c29" value='&lt;font style="font-size:24px"&gt;&lt;b&gt;2&lt;/b&gt;&lt;/font&gt;&lt;br&gt;replayed' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;shadow=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="705" y="1020" width="165" height="90" as="geometry"/></mxCell><mxCell id="c30" value='&lt;font style="font-size:24px"&gt;&lt;b&gt;107&lt;/b&gt;&lt;/font&gt;&lt;br&gt;reached DB' style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;shadow=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="890" y=