eometry x="1320" y="545" width="226" height="54" as="geometry"/></mxCell><mxCell id="c48" value="own cell: pods, Redis,&lt;br&gt;DB pool, limits" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;shadow=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1320" y="631" width="226" height="62" as="geometry"/></mxCell><mxCell id="e49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c32" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e50" value="via Kafka" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c35" target="c41"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="425" y="529"/><mxPoint x="929" y="529"/></Array></mxGeometry></mxCell><mxCell id="c51" value="⑩ Little’s law sizing (numbers from the design)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fff2cc;strokeColor=#d6b656;opacity=55;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="760" height="180" as="geometry"/></mxCell><mxCell id="c52" value="Reserve path: 10,000 req/s × 20 ms = &lt;b&gt;200 in flight&lt;/b&gt; → 18 pods × 16 workers = 288 slots (69% busy)&lt;br&gt;DB: only ~107 requests ever reach Postgres; 100 tx/s × 30 ms = 3 busy connections → pool of &lt;b&gt;40&lt;/b&gt; is plenty&lt;br&gt;500k req/s peak: 97% stopped at L1 in our simulation → ~15k req/s reach origin; waiting room admits 5k/s" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=0;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="795" width="720" height="130" as="geometry"/></mxCell><mxCell id="c53" value="⑭ Load tests that do not lie" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#666666;opacity=55;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="830" y="760" width="770" height="180" as="geometry"/></mxCell><mxCell id="c54" value="Open-loop arrivals (Locust constant arrival rate, JMeter Precise Throughput Timer).&lt;br&gt;Latency measured from the &lt;b&gt;intended&lt;/b&gt; start time → HdrHistogram.&lt;br&gt;Our 2 s stall model: closed-loop p99 = &lt;b&gt;1 ms&lt;/b&gt; (lies), open-loop p99 = &lt;b&gt;1,902 ms&lt;/b&gt; (truth)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=0;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="850" y="795" width="730" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>